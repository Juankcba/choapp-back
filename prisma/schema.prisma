generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

// ─── NextAuth Models ────────────────────────────────────

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordReset {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  token     String   @unique
  expires   DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── App Models ─────────────────────────────────────────

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  email         String    @unique
  emailVerified DateTime?
  password      String?
  phone         String?
  role          String    @default("family") // family | caregiver | admin
  firstName     String?
  lastName      String?
  name          String?
  image         String?
  isActive      Boolean   @default(true)
  // Exclude from all public listings (map, sitemap, stats, search).
  // Used for internal test accounts that should not leak to production visitors.
  isTestAccount Boolean   @default(false)
  // Identity verification (KYC via Didit).
  // dni is NOT a Prisma @unique: multiple users may have `dni: null` before
  // completing KYC, which would violate a Mongo unique index. Uniqueness of
  // non-null DNIs is enforced in application code (VerificationService).
  dni                   String?
  identityStatus        String    @default("unverified") // unverified | pending | verified | rejected
  diditSessionId        String?
  diditVerifiedAt       DateTime?
  lastLogin     DateTime?
  // Consent to Terms & Privacy. `termsAcceptedVersion` stores the version
  // string (see TERMS_VERSION). When the operator bumps the version, users
  // with an older value are prompted to accept again on next login.
  termsAcceptedAt       DateTime?
  termsAcceptedVersion  String?
  // Soft-delete: the user requested account deletion. Auth rejects login
  // once this is set. A cron job purges personal data 30 days later.
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  passwordResets PasswordReset[]
  caregiver      Caregiver?
  family         Family?
  reviews        Review[]
  fcmTokens      String[]
}

model Caregiver {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  userId             String   @unique @db.ObjectId
  bio                String   @default("")
  specialties        String[]
  experience         Int      @default(0)
  hourlyRate         Float    @default(0)
  certifications     Json[]
  documents          Json[]
  rating             Float    @default(0)
  totalReviews       Int      @default(0)
  totalServices      Int      @default(0)
  isAvailable        Boolean  @default(true)
  schedule           Json[]
  serviceRadius      Int      @default(30000)
  locationLat        Float?
  locationLng        Float?
  // Account activation state under the new positioning (2026-04):
  //   pending   = caregiver still needs to finish registration (KYC, record, profile).
  //   active    = registration complete; caregiver can operate. CHO does NOT
  //               vouch for professional capabilities — see positioning memory.
  //   suspended = CHO suspended the account in response to a concrete report.
  activationStatus   String   @default("pending")
  // Legacy field kept during transition — mirrors activationStatus (verified↔active,
  // rejected↔suspended). Will be removed after all clients consume activationStatus.
  verificationStatus String   @default("pending")
  // Campos de pago eliminados el 2026-04-19: CHO dejó de intermediar pagos.
  // earningsTotal/Pending/Available, bankCbu/Alias/Name y paymentSchemes ya
  // no tienen propósito legítimo — ver scripts/wipe_payment_fields.ts para
  // el cleanup de datos existentes en Atlas.
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  services             Service[]              @relation("CaregiverServices")
  reviews              Review[]
  serviceNotifications ServiceNotification[]
  chats                Chat[]
}

model Family {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  userId                String   @unique @db.ObjectId
  address               String?
  locationLat           Float?
  locationLng           Float?
  emergencyContactName  String?
  emergencyContactPhone String?
  emergencyContactRel   String?
  paymentMethods        Json[]
  favoriteCaregiverIds  String[] @db.ObjectId
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  services Service[]
  reviews  Review[]
}

model Service {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  familyId       String    @db.ObjectId
  caregiverId    String?   @db.ObjectId
  serviceType    String // companionship | medication | rehabilitation | postSurgery | specialCare
  status         String    @default("pending") // pending | matched | accepted | inProgress | completed | cancelled
  patientName    String?
  patientAge     Int?
  patientCondition String?
  specialNeeds   String?
  scheduledDate  DateTime?
  duration       Int? // in hours
  actualStart    DateTime?
  actualEnd      DateTime?
  notes          String?

  // ─── Modality & recurrence (virtual services, 2026-04) ─────────────
  // `in_person`  → geographic matching applies (SERVICE_RADIUS_KM = 30).
  // `virtual`    → radio se ignora; video corre sobre infra de medixalink.
  modality         String    @default("in_person") // in_person | virtual
  // Especialidad buscada del cuidador (ver common/specialties.ts para la lista
  // cerrada permitida). Distinto de `serviceType`: serviceType describe la
  // actividad del servicio, specialty describe el perfil profesional buscado.
  specialty        String?
  // Solo para virtuales: cuántas sesiones por semana se pactan y en qué slots.
  sessionsPerWeek  Int?
  // Array de { dayOfWeek: 0-6, startTime: "HH:MM", durationMin: number }.
  preferredSlots   Json[]

  // Service location (where the service is performed, e.g. hospital, patient home)
  serviceAddress     String?
  serviceLocationLat Float?
  serviceLocationLng Float?

  // Family location (for matching)
  locationLat    Float?
  locationLng    Float?

  // Campos de pago eliminados el 2026-04-19 (CHO no intermedia pagos):
  // amount, paymentMethod, paymentStatus, mpPaymentId, mpPreferenceId,
  // commissionFamily, commissionCarer, netAmount, releasedAt,
  // agreedHourlyRate, paymentScheme. Ver scripts/wipe_payment_fields.ts
  // para limpiar los documentos en Atlas.

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  family               Family                @relation(fields: [familyId], references: [id])
  caregiver            Caregiver?            @relation("CaregiverServices", fields: [caregiverId], references: [id])
  chats                Chat[]
  reviews              Review[]
  serviceNotifications ServiceNotification[]
  videoSessions        VideoSession[]
  // ServicePayout[] eliminado: modelo dropeado el 2026-04-19.
}

// Modelo ServicePayout eliminado el 2026-04-19 junto con toda la
// integración de MercadoPago. CHO no retiene ni libera fondos.
// Ver scripts/wipe_payment_fields.ts para dropear la colección en Atlas.

model Chat {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  serviceId   String    @db.ObjectId
  caregiverId String    @db.ObjectId
  messages    Message[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  service   Service   @relation(fields: [serviceId], references: [id])
  caregiver Caregiver @relation(fields: [caregiverId], references: [id])

  @@unique([serviceId, caregiverId])
}

type Message {
  senderId        String   @db.ObjectId
  senderName      String?
  content         String
  timestamp       DateTime @default(now())
  read            Boolean  @default(false)
  notifiedByEmail Boolean  @default(false)
}

model Review {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  serviceId   String   @db.ObjectId
  caregiverId String?  @db.ObjectId
  familyId    String?  @db.ObjectId
  reviewerId  String   @db.ObjectId
  reviewType  String   @default("family_to_caregiver") // family_to_caregiver | caregiver_to_family
  rating      Int
  comment     String?
  createdAt   DateTime @default(now())

  service   Service    @relation(fields: [serviceId], references: [id])
  caregiver Caregiver? @relation(fields: [caregiverId], references: [id])
  family    Family?    @relation(fields: [familyId], references: [id])
  reviewer  User       @relation(fields: [reviewerId], references: [id])
}

model ServiceNotification {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  serviceId   String    @db.ObjectId
  caregiverId String    @db.ObjectId
  status      String    @default("pending") // pending | accepted | declined | expired
  // Km from service location. Null para servicios virtuales (sin filtro geográfico).
  distance    Float?
  notifiedVia String    // websocket | email | both
  readAt      DateTime?
  respondedAt DateTime?
  createdAt   DateTime  @default(now())

  service   Service   @relation(fields: [serviceId], references: [id])
  caregiver Caregiver @relation(fields: [caregiverId], references: [id])
}

// ─── Video Sessions ────────────────────────────────────
// Materialización de cada turno de un servicio virtual. Un `Service` con
// `modality = "virtual"` + `sessionsPerWeek` + `preferredSlots` genera N
// `VideoSession` al ser aceptado por un cuidador.
//
// El room name del token Jitsi se construye como `cho-<VideoSession.id>` del
// lado de medixalink auth-service (ver /tools/telemedicine/partner-token).
// Cho no almacena el JWT — se solicita fresh a medixalink al momento de unirse.
model VideoSession {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  serviceId       String    @db.ObjectId
  familyId        String    @db.ObjectId
  caregiverId     String    @db.ObjectId
  // Inicio y fin pactados para esta sesión puntual.
  startAt         DateTime
  endAt           DateTime
  // scheduled  → creada, aún no llega el momento.
  // ready      → en ventana de 15 min previos al startAt; puede unirse.
  // in_progress→ al menos un participante entró.
  // completed  → terminó normalmente (o pasó su ventana).
  // cancelled  → cancelada por alguna de las partes.
  status          String    @default("scheduled")
  cancelledBy     String?   // family | caregiver | system
  cancelledReason String?
  // Timestamps de entrada a la sala (informativos, no bloquean nada).
  familyJoinedAt    DateTime?
  caregiverJoinedAt DateTime?
  // Timestamps de recordatorios enviados, para evitar duplicados si el cron
  // re-ejecuta.
  remindedAt24h   DateTime?
  remindedAt15m   DateTime?

  // Campos de pago por sesión eliminados el 2026-04-19: CHO no intermedia
  // pagos. Paquete de campos dropeado: paymentStatus, amount, netAmount,
  // commissionFamily, mpPreferenceId, mpPaymentId, paymentReleasedAt,
  // paymentReminderAt. Ver scripts/wipe_payment_fields.ts para cleanup.

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  service   Service @relation(fields: [serviceId], references: [id])
}

// ─── CMS Models ─────────────────────────────────────────

model BlogPost {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  slug        String    @unique
  excerpt     String
  content     String
  imageUrl    String?
  category    String
  authorName  String
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model JobPosting {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  type         String   // full-time | part-time | contract
  location     String
  description  String
  requirements String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PressRelease {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  summary     String
  content     String?
  imageUrl    String?
  publishedAt DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── OTP Model ──────────────────────────────────────────

model OtpCode {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ─── Beta Testers ───────────────────────────────────────

model BetaTester {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  email       String   @unique
  name        String
  phone       String?
  device      String   // "android" | "ios"
  googleEmail String?
  status      String   @default("pending") // pending | approved | notified | active
  source      String   // "landing" | "family_dashboard" | "caregiver_dashboard"
  userId      String?  @db.ObjectId
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Criminal Record (Antecedentes Penales) ─────────────

model CriminalRecord {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  fileUrl     String
  fileName    String
  fileType    String
  issueDate   DateTime
  expiresAt   DateTime
  notes       String?
  uploadedBy  String   @db.ObjectId
  notifiedAt  DateTime?
  createdAt   DateTime @default(now())
}
